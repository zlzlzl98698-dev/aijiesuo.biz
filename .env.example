# Search Engine Site Verification Codes (injected directly into static HTML <head> at build time)
# Leave empty until you obtain real verification tokens from each webmaster platform.
VITE_VERIFY_GOOGLE=
VITE_VERIFY_BING=
VITE_VERIFY_SHENMA=
VITE_VERIFY_BAIDU=

# Optional Algolia DocSearch (falls back to built-in VitePress Local Search when empty)
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_API_KEY=
VITE_ALGOLIA_INDEX_NAME=
