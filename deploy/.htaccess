# ==============================================================================
# Apache Production Configuration (.htaccess) for aijiesuo.biz (AI解锁)
# Static output generated by VitePress (docs/.vitepress/dist)
# ==============================================================================

DirectoryIndex index.html
DirectorySlash On
Options -Indexes +FollowSymLinks -MultiViews

AddDefaultCharset UTF-8

# Custom 404 page returning real HTTP 404 status (local path, never full URL)
ErrorDocument 404 /404.html

# ------------------------------------------------------------------------------
# MIME Types (feeds, VitePress local search chunks, modern images/fonts)
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/html .html .htm
  AddType text/plain .txt
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType application/xml .xml
  AddType application/rss+xml .rss
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

<Files "rss.xml">
  <IfModule mod_mime.c>
    ForceType application/rss+xml
  </IfModule>
  AddDefaultCharset UTF-8
</Files>

<Files "sitemap.xml">
  <IfModule mod_mime.c>
    ForceType application/xml
  </IfModule>
  AddDefaultCharset UTF-8
</Files>

# ------------------------------------------------------------------------------
# URL Rewriting: Force HTTPS, Canonical Host, Static Clean URLs (NO SPA Fallback)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS (handles both direct TLS and reverse-proxy X-Forwarded-Proto)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://aijiesuo.biz%{REQUEST_URI} [R=301,L]

  # 2. Canonical host redirect (www.aijiesuo.biz / alias -> aijiesuo.biz)
  RewriteCond %{HTTP_HOST} !^aijiesuo\.biz$ [NC]
  RewriteRule ^ https://aijiesuo.biz%{REQUEST_URI} [R=301,L]

  # 3. Explicit passthrough for feeds, robots.txt, and hashed/static asset dirs
  #    Includes VitePress local search chunks under /assets/chunks/
  RewriteRule ^(sitemap\.xml|robots\.txt|rss\.xml)$ - [L]
  RewriteRule ^(assets|images)/ - [L]

  # 4. Normalize trailing slash on non-directory clean URLs when .html file exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^/(.+)/$
  RewriteCond %{DOCUMENT_ROOT}/%1.html -f
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 5. Serve existing static files and directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 6. Clean HTML resolution (/path -> /path.html) only if target .html exists
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # IMPORTANT: No SPA catch-all RewriteRule to /index.html.
  # Any unmatched route returns real HTTP 404 and renders /404.html.
</IfModule>

# ------------------------------------------------------------------------------
# Compression (Brotli preferred, Gzip/Deflate fallback)
# ------------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml font/ttf font/otf
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/x-javascript application/json application/xml application/rss+xml image/svg+xml font/ttf font/otf
</IfModule>

# ------------------------------------------------------------------------------
# Caching Policy
# - /assets/* (hashed JS, CSS, VitePress local search chunks, fonts): 1y immutable
# - /images/*: 30 days
# - .html: no-cache (always revalidate on deploy)
# - sitemap.xml, rss.xml, robots.txt: short 1h cache
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType application/rss+xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Security Headers (always set so 404 responses also receive them)
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

  # HTML: always revalidate
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Feeds & robots.txt: short cache
  <FilesMatch "^(sitemap\.xml|rss\.xml|robots\.txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # VitePress hashed assets & local search chunks: 1 year immutable
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Brand logos & speedtest screenshots: 30 days
  <If "%{REQUEST_URI} =~ m#^/images/#">
    Header set Cache-Control "public, max-age=2592000"
  </If>
</IfModule>
